# Yosys synthesis script for NEORV32 on EP4CE6 (ghdl-yosys-plugin).
# NOTE: VHDL source paths are absolute to this machine's neorv32_rot checkout.
#       Adjust /home/test/neorv32_rot/ to your local clone path before use.
plugin -i ghdl
ghdl --std=08 --work=neorv32 -fsynopsys -frelaxed -gCLOCK_FREQUENCY=50000000 -gBOOT_MODE_SELECT=2 -gRISCV_ISA_C=true -gRISCV_ISA_M=true -gRISCV_ISA_U=true -gRISCV_ISA_Zaamo=true -gRISCV_ISA_Zalrsc=true -gRISCV_ISA_Zicntr=true -gIMEM_EN=true -gIMEM_SIZE=16384 -gDMEM_EN=true -gDMEM_SIZE=8192 -gXBUS_EN=true -gXBUS_TIMEOUT=4096 -gIO_GPIO_NUM=4 -gIO_CLINT_EN=true -gIO_UART0_EN=true -gIO_UART0_RX_FIFO=4 -gIO_UART0_TX_FIFO=4 -gIO_SPI_EN=true -gICACHE_EN=true -gCACHE_BLOCK_SIZE=64 -gDCACHE_EN=true /home/test/neorv32_rot/neorv32/rtl/core/neorv32_package.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_sys.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu_decompressor.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu_frontend.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu_control.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu_hwtrig.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_prim.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu_counters.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu_regfile.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu_alu_shifter.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu_alu_muldiv.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu_alu_bitmanip.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu_alu_fpu.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu_alu_cfu.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu_alu_cond.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu_alu_crypto.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu_alu.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu_lsu.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu_pmp.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu_trace.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cpu.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cache.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_bus.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_dma.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_imem.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_dmem.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_xbus.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_bootrom.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cfs.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_sdi.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_gpio.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_wdt.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_clint.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_uart.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_spi.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_twi.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_twd.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_pwm.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_trng.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_neoled.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_gptmr.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_onewire.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_slink.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_tracer.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_sysinfo.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_debug_dtm.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_debug_auth.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_debug_dm.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_top.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_cache_ram.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_imem_image.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_imem_rom.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_imem_ram.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_dmem_ram.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_bootrom_image.vhd /home/test/neorv32_rot/neorv32/rtl/core/neorv32_bootrom_rom.vhd -e neorv32_top
hierarchy -check -top neorv32_top
proc
async2sync
memory_libmap -lib /home/test/EP4CE6/synth/m9k.lib
memory_map
opt -full
flatten
opt -full
techmap
opt -fast
dffunmap -ce-only
dffunmap -srst-only
abc -lut 4
clean
techmap -map /home/test/EP4CE6/synth/ep4ce6_map.v
clean
stat
write_json /tmp/nv32_synth/neorv32.json
