#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# ζ pre-commit hook: run the sub-second selftest before every commit.
#
# Install with:
#     git config core.hooksPath .githooks
#
# Skip once:
#     ZETA_SKIP=1 git commit ...
#
# Rationale: `zeta_selftest.py` is an invariant gate — a 1710-bit round-trip
# on a HW-validated two-LAB gold. If any commit breaks it, ζ or fasm2rbf has
# drifted in a way that will cascade into every downstream production build.
# Catching it here is strictly cheaper than catching it at flash time.
set -e

if [[ "${ZETA_SKIP:-}" == "1" ]]; then
    echo "[pre-commit] ZETA_SKIP=1 set, skipping ζ selftest"
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
SELFTEST="$REPO_ROOT/scripts/bit_workaround/zeta_selftest.py"

if [[ ! -f "$SELFTEST" ]]; then
    echo "[pre-commit] selftest missing ($SELFTEST); skipping"
    exit 0
fi

# Fixture is gitignored and may not exist locally; skip gracefully in that case.
# Make this VERY visible so devs notice the gate is bypassed (audit fix
# 2026-05-03: previous silent-skip caused gate to evaporate on fresh clones).
FIXTURE="$REPO_ROOT/tmp/chipdb_test/quartus_two_lab/output_files/two_lab.rbf"
if [[ ! -f "$FIXTURE" ]]; then
    echo "" >&2
    echo "[pre-commit] ⚠️  WARNING: ζ regression gate BYPASSED" >&2
    echo "[pre-commit] ⚠️  fixture missing: $FIXTURE" >&2
    echo "[pre-commit] ⚠️  this commit is NOT gated against ζ codec drift." >&2
    echo "[pre-commit] ⚠️  rebuild fixture: cd tmp/chipdb_test/quartus_two_lab && quartus_sh --flow compile two_lab" >&2
    echo "" >&2
    exit 0
fi

echo "[pre-commit] running ζ selftest..."
if ! python3 "$SELFTEST" >/tmp/zeta_selftest.log 2>&1; then
    echo "[pre-commit] ζ selftest FAILED — commit blocked."
    echo "            bypass once with: ZETA_SKIP=1 git commit ..."
    echo "            last log:"
    tail -20 /tmp/zeta_selftest.log | sed 's/^/              /'
    exit 1
fi
echo "[pre-commit] ζ selftest OK"

# Phase 3 LI MUX std_lut TT regression — fast (<1s).  Catches any
# future codec drift that re-corrupts the σ⁻¹ TT cells at colliding
# Y values (Pitfall #13 fix landed 2026-05-05 / commit 0cdec7a).
PHASE3_TEST="$REPO_ROOT/fuzz/test_phase3_li_mux_lut_tt.py"
if [[ -f "$PHASE3_TEST" ]]; then
    echo "[pre-commit] running Phase 3 LI MUX collision test..."
    if ! python3 "$PHASE3_TEST" >/tmp/phase3_test.log 2>&1; then
        echo "[pre-commit] Phase 3 collision test FAILED — commit blocked."
        echo "            bypass once with: ZETA_SKIP=1 git commit ..."
        echo "            last log:"
        tail -20 /tmp/phase3_test.log | sed 's/^/              /'
        exit 1
    fi
    echo "[pre-commit] Phase 3 collision test OK"
fi

# P1 bypass_aware byte-identity gate — ~2s.  Locks the 8 BYPASS_1INPUT_MASKS
# (+ 2 constants) against Quartus canon_*_X4Y4N0.rbf references.  Catches any
# future codec drift that re-breaks the end-to-end open-toolchain ↔ Quartus
# byte-identity for 1-input bypass class (P1 of plan
# imperative-crafting-pumpkin, silicon-validated 2026-05-13 via canon_b
# bitgen flash; memo p1_bypass_aware_silicon_validated_2026_05_13).
#
# Skips gracefully if Quartus canon_*_X4Y4N0.rbf cache is missing
# (tmp/real_tt_mining/ is gitignored).
BYPASS_TEST="$REPO_ROOT/fuzz/test_bypass_byte_identity.py"
BYPASS_FIXTURE="$REPO_ROOT/tmp/real_tt_mining/canon_a_X4Y4N0/canon_a_X4Y4N0.rbf"
if [[ -f "$BYPASS_TEST" && -f "$BYPASS_FIXTURE" ]]; then
    echo "[pre-commit] running bypass byte-identity test..."
    if ! python3 "$BYPASS_TEST" >/tmp/bypass_byte_identity.log 2>&1; then
        echo "[pre-commit] bypass byte-identity FAILED — commit blocked."
        echo "            bypass once with: ZETA_SKIP=1 git commit ..."
        echo "            last log:"
        tail -20 /tmp/bypass_byte_identity.log | sed 's/^/              /'
        exit 1
    fi
    echo "[pre-commit] bypass byte-identity OK"
elif [[ -f "$BYPASS_TEST" ]]; then
    echo "[pre-commit] ⚠️  bypass byte-identity gate BYPASSED" >&2
    echo "[pre-commit] ⚠️  fixture missing: $BYPASS_FIXTURE" >&2
    echo "[pre-commit] ⚠️  rebuild via: scripts/sigma_inv_real_tt_mining/probe_canonicalization_cells.py 4 4 0" >&2
fi
