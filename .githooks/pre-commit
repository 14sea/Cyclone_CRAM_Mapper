#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# ζ pre-commit hook: run the sub-second selftest before every commit.
#
# Install with:
#     git config core.hooksPath .githooks
#
# Skip once:
#     ZETA_SKIP=1 git commit ...
#
# Rationale: `zeta_selftest.py` is an invariant gate — a 1710-bit round-trip
# on a HW-validated two-LAB gold. If any commit breaks it, ζ or fasm2rbf has
# drifted in a way that will cascade into every downstream production build.
# Catching it here is strictly cheaper than catching it at flash time.
set -e

if [[ "${ZETA_SKIP:-}" == "1" ]]; then
    echo "[pre-commit] ZETA_SKIP=1 set, skipping ζ selftest"
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
SELFTEST="$REPO_ROOT/scripts/bit_workaround/zeta_selftest.py"

if [[ ! -f "$SELFTEST" ]]; then
    echo "[pre-commit] selftest missing ($SELFTEST); skipping"
    exit 0
fi

# Fixture is gitignored and may not exist locally; skip gracefully in that case.
# Make this VERY visible so devs notice the gate is bypassed (audit fix
# 2026-05-03: previous silent-skip caused gate to evaporate on fresh clones).
FIXTURE="$REPO_ROOT/tmp/chipdb_test/quartus_two_lab/output_files/two_lab.rbf"
if [[ ! -f "$FIXTURE" ]]; then
    echo "" >&2
    echo "[pre-commit] ⚠️  WARNING: ζ regression gate BYPASSED" >&2
    echo "[pre-commit] ⚠️  fixture missing: $FIXTURE" >&2
    echo "[pre-commit] ⚠️  this commit is NOT gated against ζ codec drift." >&2
    echo "[pre-commit] ⚠️  rebuild fixture: cd tmp/chipdb_test/quartus_two_lab && quartus_sh --flow compile two_lab" >&2
    echo "" >&2
    exit 0
fi

echo "[pre-commit] running ζ selftest..."
if ! python3 "$SELFTEST" >/tmp/zeta_selftest.log 2>&1; then
    echo "[pre-commit] ζ selftest FAILED — commit blocked."
    echo "            bypass once with: ZETA_SKIP=1 git commit ..."
    echo "            last log:"
    tail -20 /tmp/zeta_selftest.log | sed 's/^/              /'
    exit 1
fi
echo "[pre-commit] ζ selftest OK"
