#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# ζ pre-commit hook: run the sub-second selftest before every commit.
#
# Install with:
#     git config core.hooksPath .githooks
#
# Skip once:
#     ZETA_SKIP=1 git commit ...
#
# Rationale: `zeta_selftest.py` is an invariant gate — a 1710-bit round-trip
# on a HW-validated two-LAB gold. If any commit breaks it, ζ or fasm2rbf has
# drifted in a way that will cascade into every downstream production build.
# Catching it here is strictly cheaper than catching it at flash time.
set -e

if [[ "${ZETA_SKIP:-}" == "1" ]]; then
    echo "[pre-commit] ZETA_SKIP=1 set, skipping ζ selftest"
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
SELFTEST="$REPO_ROOT/scripts/bit_workaround/zeta_selftest.py"

if [[ ! -f "$SELFTEST" ]]; then
    echo "[pre-commit] selftest missing ($SELFTEST); skipping"
    exit 0
fi

# Fixture is gitignored and may not exist locally; skip gracefully in that case.
# Make this VERY visible so devs notice the gate is bypassed (audit fix
# 2026-05-03: previous silent-skip caused gate to evaporate on fresh clones).
FIXTURE="$REPO_ROOT/tmp/chipdb_test/quartus_two_lab/output_files/two_lab.rbf"
if [[ ! -f "$FIXTURE" ]]; then
    echo "" >&2
    echo "[pre-commit] ⚠️  WARNING: ζ regression gate BYPASSED" >&2
    echo "[pre-commit] ⚠️  fixture missing: $FIXTURE" >&2
    echo "[pre-commit] ⚠️  this commit is NOT gated against ζ codec drift." >&2
    echo "[pre-commit] ⚠️  rebuild fixture: cd tmp/chipdb_test/quartus_two_lab && quartus_sh --flow compile two_lab" >&2
    echo "" >&2
    exit 0
fi

echo "[pre-commit] running ζ selftest..."
if ! python3 "$SELFTEST" >/tmp/zeta_selftest.log 2>&1; then
    echo "[pre-commit] ζ selftest FAILED — commit blocked."
    echo "            bypass once with: ZETA_SKIP=1 git commit ..."
    echo "            last log:"
    tail -20 /tmp/zeta_selftest.log | sed 's/^/              /'
    exit 1
fi
echo "[pre-commit] ζ selftest OK"

# Phase 3 LI MUX std_lut TT regression — fast (<1s).  Catches any
# future codec drift that re-corrupts the σ⁻¹ TT cells at colliding
# Y values (Pitfall #13 fix landed 2026-05-05 / commit 0cdec7a).
PHASE3_TEST="$REPO_ROOT/fuzz/test_phase3_li_mux_lut_tt.py"
if [[ -f "$PHASE3_TEST" ]]; then
    echo "[pre-commit] running Phase 3 LI MUX collision test..."
    if ! python3 "$PHASE3_TEST" >/tmp/phase3_test.log 2>&1; then
        echo "[pre-commit] Phase 3 collision test FAILED — commit blocked."
        echo "            bypass once with: ZETA_SKIP=1 git commit ..."
        echo "            last log:"
        tail -20 /tmp/phase3_test.log | sed 's/^/              /'
        exit 1
    fi
    echo "[pre-commit] Phase 3 collision test OK"
fi

# P1 bypass_aware byte-identity gate — ~2s.  Locks the 8 BYPASS_1INPUT_MASKS
# (+ 2 constants) against Quartus canon_*_X4Y4N0.rbf references.  Catches any
# future codec drift that re-breaks the end-to-end open-toolchain ↔ Quartus
# byte-identity for 1-input bypass class (P1 of plan
# imperative-crafting-pumpkin, silicon-validated 2026-05-13 via canon_b
# bitgen flash; memo p1_bypass_aware_silicon_validated_2026_05_13).
#
# Skips gracefully if Quartus canon_*_X4Y4N0.rbf cache is missing
# (tmp/real_tt_mining/ is gitignored).
BYPASS_TEST="$REPO_ROOT/fuzz/test_bypass_byte_identity.py"
BYPASS_FIXTURE="$REPO_ROOT/tmp/real_tt_mining/canon_a_X4Y4N0/canon_a_X4Y4N0.rbf"
if [[ -f "$BYPASS_TEST" && -f "$BYPASS_FIXTURE" ]]; then
    echo "[pre-commit] running bypass byte-identity test..."
    if ! python3 "$BYPASS_TEST" >/tmp/bypass_byte_identity.log 2>&1; then
        echo "[pre-commit] bypass byte-identity FAILED — commit blocked."
        echo "            bypass once with: ZETA_SKIP=1 git commit ..."
        echo "            last log:"
        tail -20 /tmp/bypass_byte_identity.log | sed 's/^/              /'
        exit 1
    fi
    echo "[pre-commit] bypass byte-identity OK"
elif [[ -f "$BYPASS_TEST" ]]; then
    echo "[pre-commit] ⚠️  bypass byte-identity gate BYPASSED" >&2
    echo "[pre-commit] ⚠️  fixture missing: $BYPASS_FIXTURE" >&2
    echo "[pre-commit] ⚠️  rebuild via: scripts/sigma_inv_real_tt_mining/probe_canonicalization_cells.py 4 4 0" >&2
fi

# P2 canon-2input byte-identity gate — ~1s.  Locks 24 canonical 2-input
# mask labels (18 perm + 6 neg) at X4Y4N0 against Quartus
# canon_{label}_X4Y4N0.rbf via both LutCodec.write_tt(canon_2input=) and
# bitgen(canon_2input_aware=True).  Catches any future codec drift that
# re-breaks the σ⁻¹ predict_sram-gap closure (Pitfall #16 main axis,
# P2 of plan imperative-crafting-pumpkin, silicon-validated 2026-05-13
# via mask=0x4444 !KEY1&KEY2 flash; memo
# p2_canon_2input_silicon_validated_2026_05_13).
#
# Skips gracefully if Quartus canon_{aandb,...}_X4Y4N0.rbf cache is missing
# (tmp/real_tt_mining/ is gitignored).
CANON_2INPUT_TEST="$REPO_ROOT/fuzz/test_canon_2input_codec.py"
CANON_2INPUT_FIXTURE="$REPO_ROOT/tmp/real_tt_mining/canon_aandb_X4Y4N0/canon_aandb_X4Y4N0.rbf"
if [[ -f "$CANON_2INPUT_TEST" && -f "$CANON_2INPUT_FIXTURE" ]]; then
    echo "[pre-commit] running canon-2input byte-identity test..."
    if ! python3 "$CANON_2INPUT_TEST" >/tmp/canon_2input.log 2>&1; then
        echo "[pre-commit] canon-2input byte-identity FAILED — commit blocked."
        echo "            bypass once with: ZETA_SKIP=1 git commit ..."
        echo "            last log:"
        tail -20 /tmp/canon_2input.log | sed 's/^/              /'
        exit 1
    fi
    echo "[pre-commit] canon-2input byte-identity OK"
elif [[ -f "$CANON_2INPUT_TEST" ]]; then
    echo "[pre-commit] ⚠️  canon-2input byte-identity gate BYPASSED" >&2
    echo "[pre-commit] ⚠️  fixture missing: $CANON_2INPUT_FIXTURE" >&2
    echo "[pre-commit] ⚠️  rebuild via: scripts/sigma_inv_real_tt_mining/probe_canonicalization_cells.py 4 4 0 --2input --save  AND  --2input-negation --save" >&2
fi

# Path 5 d1pp canon-cell table reconstruction gate — ~1s.  Walks the
# (x,y,n,mask) entries in results/canon_2input_codec_table_d1pp.json,
# rebuilds each Quartus golden RBF as `baseline_mask0 XOR predict_sram(M)
# XOR canon_cells[M]` and bit-compares against the committed gold.  Catches
# drift in LutCodec.from_cram_model / predict_sram that would silently
# invalidate the mined table consumed by mode H (lutcodec.c).
#
# Fixtures (results/golden_rbf_modeH/) are committed, so this gate runs
# unconditionally on every clone.
D1PP_VERIFIER="$REPO_ROOT/scripts/mode_h/verify_canon_d1pp_table.py"
D1PP_TABLE="$REPO_ROOT/results/canon_2input_codec_table_d1pp.json"
D1PP_FIXTURE="$REPO_ROOT/results/golden_rbf_modeH/sweep_summary.json"
if [[ -f "$D1PP_VERIFIER" && -f "$D1PP_TABLE" && -f "$D1PP_FIXTURE" ]]; then
    echo "[pre-commit] running Path 5 d1pp canon-cell table verifier..."
    if ! python3 "$D1PP_VERIFIER" >/tmp/d1pp_verifier.log 2>&1; then
        echo "[pre-commit] d1pp canon-cell verifier FAILED — commit blocked."
        echo "            bypass once with: ZETA_SKIP=1 git commit ..."
        echo "            last log:"
        tail -20 /tmp/d1pp_verifier.log | sed 's/^/              /'
        exit 1
    fi
    # Echo the verifier's own count (avoids a hardcoded total that rots
    # whenever the table grows — e.g. 18 -> 30 when 0xDEAD was extended).
    D1PP_SUMMARY="$(grep -oE '[0-9]+/[0-9]+ builds reconstruct byte-identical' /tmp/d1pp_verifier.log | tail -1)"
    echo "[pre-commit] d1pp canon-cell verifier OK (${D1PP_SUMMARY:-byte-identical})"
fi

# Track B1 IOB_ROUTE reorder regression — ~1s.  Verifies that bitgen's
# `if iob_routes:` block stays AFTER `if all_luts:` (the 2026-05-21
# Track B1 reorder that resolves OUTROUTE_G15 × IOB_ROUTE XOR-cancel
# at LI-aliased cells).  Structural test always runs from source;
# byte-identity tests gracefully skip if Quartus goldens are absent
# (work/ is gitignored — rebuild via mine_padnv_x4y4n0.py).
REORDER_TEST="$REPO_ROOT/fuzz/test_iob_route_x4y4_reorder.py"
if [[ -f "$REORDER_TEST" ]]; then
    echo "[pre-commit] running Track B1 iob_route reorder regression..."
    if ! python3 "$REORDER_TEST" >/tmp/reorder_test.log 2>&1; then
        echo "[pre-commit] reorder regression FAILED — commit blocked."
        echo "            bypass once with: ZETA_SKIP=1 git commit ..."
        echo "            last log:"
        tail -20 /tmp/reorder_test.log | sed 's/^/              /'
        exit 1
    fi
    echo "[pre-commit] reorder regression OK"
fi

# LI-MUX composition gate regression — ~2s.  Locks the gold-anchored gate
# (fuzz/li_mux_conflict_gate.py) that closes the P5d false-green hole: a LAB
# whose LE input-MUX (LI) cells are co-determined by a LUT + routing
# directive must pass gold byte-identity at those cells before flash.  Core
# 8 checks run unconditionally from the committed nv_zero_global.rbf; the
# real-gold checks self-skip if the (gitignored) Quartus gold is absent.
# Memo: track_d_xlab_codec_quartus_forensic_2026_05_28.
LI_MUX_TEST="$REPO_ROOT/fuzz/test_li_mux_conflict_gate.py"
if [[ -f "$LI_MUX_TEST" ]]; then
    echo "[pre-commit] running LI-MUX composition gate regression..."
    if ! python3 "$LI_MUX_TEST" >/tmp/li_mux_gate.log 2>&1; then
        echo "[pre-commit] LI-MUX gate regression FAILED — commit blocked."
        echo "            bypass once with: ZETA_SKIP=1 git commit ..."
        echo "            last log:"
        tail -20 /tmp/li_mux_gate.log | sed 's/^/              /'
        exit 1
    fi
    echo "[pre-commit] LI-MUX gate regression OK"
fi
